# FileGuard / Internal Brain — environment template.
# Copy to .env and fill in. NEVER commit real secrets.
# Defaults below are the dev-only demo values; see README.md "Configuration".

# --- Storage -----------------------------------------------------------
FILEGUARD_DATA_DIR=./data

# --- Keys (separate key per purpose; production: KMS/secret manager) ----
FILEGUARD_SECRET_KEY=dev-only-secret-key      # HMAC for session grants
FILEGUARD_STORE_KEY=1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988  # hex, AES-256 content store
FILEGUARD_RECEIPT_KEY=dev-only-receipt-key    # Ed25519 seed, delivery receipts
FILEGUARD_POLICY_VERSION=1

# --- Sessions / confirmations -------------------------------------------
FILEGUARD_GRANT_TTL=3600                      # sliding, seconds
FILEGUARD_NONCE_TTL=300                       # confirmation nonce, seconds

# --- Models -------------------------------------------------------------
FILEGUARD_GATEKEEPER_MODE=live                # live (Claude) | test (offline stubs)
FILEGUARD_GATEKEEPER_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Demo ---------------------------------------------------------------
FILEGUARD_DEMO_NOW=2026-10-14T14:05:00+08:00  # Company A demo clock
